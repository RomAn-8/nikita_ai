TELEGRAM_BOT_TOKEN=123456:ABCDEF
OPENROUTER_API_KEY=sk-or-xxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# Fine-tuning pipeline (прямой OpenAI API, не OpenRouter)
