OPENAI_API_KEY=sk-xxxxxxxx
FT_BASE_MODEL=gpt-4o-mini-2024-07-18
# FT_DATA_PATH по умолчанию = finetune/data внутри проекта
# FT_DATA_PATH=/абсолютный/путь/к/данным
FT_POLL_INTERVAL=30
